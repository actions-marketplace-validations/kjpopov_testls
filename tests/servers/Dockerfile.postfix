FROM docker.io/library/debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends postfix \
 && rm -rf /var/lib/apt/lists/*
# smtpd reads the key as root before dropping privileges.
COPY --chmod=0400 server.pem server.key /etc/postfix/
# STARTTLS offered but optional, TLS 1.2+, no chroot, log to stdout.
RUN postconf -e \
      myhostname=localhost \
      inet_interfaces=all \
      maillog_file=/dev/stdout \
      smtpd_tls_security_level=may \
      smtpd_tls_cert_file=/etc/postfix/server.pem \
      smtpd_tls_key_file=/etc/postfix/server.key \
      smtpd_tls_protocols='>=TLSv1.2' \
      smtpd_tls_mandatory_protocols='>=TLSv1.2' \
 && postconf -F smtp/inet/chroot=n
ENTRYPOINT ["postfix", "start-fg"]
